BOT_TOKEN=put-your-telegram-bot-token-here
# Your numeric Telegram user ID (positive).
OWNER_ID=123456789
# Your numeric channel ID (negative), not @channel_name.
CHANNEL_ID=-1001234567890
# Set to 1 to log incoming member updates in data/debug-member-updates.jsonl.
DEBUG_MEMBER_UPDATES=0
# Optional: local user login for Telegram statistics (https://my.telegram.org/apps).
# Fictional examples below: replace with your own API credentials in .env only.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Enable per-join comparisons with daily Telegram source counters.
SOURCE_STATS_ENABLED=0
# Daily summary at 11:00 Europe/Podgorica is enabled with SOURCE_STATS_ENABLED=1.
# Set to 0 to disable the daily summary.
DAILY_SUMMARY_ENABLED=
# Local default: .telegram/user.session. On Railway use /app/data/.telegram/user.session.
TELEGRAM_SESSION_PATH=.telegram/user.session
# Optional: enables per-ad join attribution; requires SOURCE_STATS_ENABLED=1.
# Obtain the token from the API tab of your Telegram Ads account.
# Set your real token in .env and Railway variables only.
TELEGRAM_ADS_API_TOKEN=
